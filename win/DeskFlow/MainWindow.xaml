<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskFlow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Trung tâm điều khiển DeskFlow Windows (WinUI 3)">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">
        <!-- Modern Seamless Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                <Image Source="Assets/Square44x44Logo.png" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock x:Name="AppTitleBlock" Text="Deskflow" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Opacity="0.85" />
            </StackPanel>
        </Grid>

        <!-- ========================================================================= -->
        <!-- PAIRING GATE (DISPLAYED WHEN UNPAIRED)                                   -->
        <!-- ========================================================================= -->
        <Grid x:Name="PairingGatePanel" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="32" MaxWidth="620">
                <StackPanel Spacing="20">
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#206366F1" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE71B;" FontSize="28" Foreground="#6366F1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="GateTitleText" Text="Yêu cầu Ghép nối Thiết bị" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="GateSubtitleText" Text="Để sử dụng Trung tâm điều khiển DeskFlow, bạn phải ghép nối máy tính này với tài khoản hệ sinh thái." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480" />
                    </StackPanel>

                    <!-- QR Code Auto-Pairing Card -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <TextBlock Text="Quét mã QR bằng ứng dụng Android DeskFlow" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
                            <TextBlock Text="Mở app Android -> Cài đặt -> Quét mã QR liên kết thiết bị khác" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <TextBox x:Name="GateDeviceNameBox" Header="Tên thiết bị hiển thị" PlaceholderText="VD: PC Windows" Width="220" KeyDown="GateDeviceNameBox_KeyDown" />
                                <Button x:Name="GateUpdateNameBtn" Content="Cập nhật QR" VerticalAlignment="Bottom" Margin="0,0,0,2" Click="GateRegenerateQr_Click" />
                            </StackPanel>

                            <Border Background="White" Padding="12" CornerRadius="12" HorizontalAlignment="Center">
                                <Image x:Name="GateQrImage" Width="180" Height="180" Stretch="Uniform" />
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <ProgressRing x:Name="GateQrProgressRing" IsActive="True" Width="18" Height="18" />
                                <TextBlock x:Name="GateQrStatusText" Text="Đang chờ quét và phê duyệt từ điện thoại..." FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="GateRegenerateQrBtn" Content="Tạo lại mã QR" HorizontalAlignment="Center" Click="GateRegenerateQr_Click" />
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="GateInstructionsText" Text="Hoặc gõ /app pair trên Discord để nhận mã ghép nối 8 ký tự:" FontSize="13" TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBox x:Name="GatePairCodeBox" PlaceholderText="Mã 8 ký tự (VD: A1B2C3D4)" FontSize="15" Height="40" VerticalContentAlignment="Center" FontFamily="Consolas" CharacterCasing="Upper" KeyDown="GatePairCodeBox_KeyDown" />
                                <Button Grid.Column="1" x:Name="GatePairButton" Content="Ghép nối thiết bị" Style="{StaticResource AccentButtonStyle}" Height="40" Padding="20,0" Click="GatePairButton_Click" />
                            </Grid>

                            <TextBlock x:Name="GateStatusText" Text="" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                        <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                        <TextBlock x:Name="GateServerUrlText" Text="Máy chủ: https://df.api.thetechdude.io.vn" FontSize="12" Foreground="#94A3B8" FontFamily="Consolas" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <NavigationView
            Grid.Row="1"
            x:Name="MainNavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            Header="Deskflow"
            SelectionChanged="MainNavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavSystemItem" Icon="Home" Content="Giám sát hệ thống &amp; Đo từ xa" Tag="system" />
                <NavigationViewItem x:Name="NavStationItem" Icon="AllApps" Content="Phần cứng &amp; Trạm ESP32" Tag="station" />
                <NavigationViewItem x:Name="NavTimetableItem" Icon="Calendar" Content="Thời khóa biểu (TKB)" Tag="timetable" />
                <NavigationViewItem x:Name="NavCalendarItem" Icon="CalendarDay" Content="Lịch Google (Calendar)" Tag="calendar" />
                <NavigationViewItem x:Name="NavSpotifyItem" Icon="Audio" Content="Spotify &amp; Âm nhạc" Tag="spotify" />
                <NavigationViewItem x:Name="NavAlarmsItem" Icon="Important" Content="Báo thức &amp; Còi báo" Tag="alarms" />
                <NavigationViewItem x:Name="NavToolsItem" Icon="Edit" Content="Công cụ &amp; Groq AI" Tag="tools" />
                <NavigationViewItem x:Name="NavSettingsItem" Icon="Setting" Content="Cài đặt &amp; Giao diện" Tag="settings" />
            </NavigationView.MenuItems>

            <ScrollViewer Padding="24">
                <StackPanel Spacing="16">
                    <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

                    <!-- ========================================================================= -->
                    <!-- GIÁM SÁT HỆ THỐNG & ĐO TỪ XA (SYSTEM & TELEMETRY - DEFAULT DASHBOARD)     -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="SystemPanel" Spacing="16">
                        <TextBlock x:Name="HeaderTitleText" Text="Trung tâm điều khiển DeskFlow Windows" FontSize="26" FontWeight="Bold" />

                        <!-- 0. Xác thực & Liên kết thiết bị -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71B;" FontSize="16" Foreground="#818CF8" />
                                    <TextBlock x:Name="PairingSectionTitle" Text="Xác thực &amp; Liên kết thiết bị" FontWeight="Bold" FontSize="15" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse x:Name="PairStatusDot" Width="9" Height="9" Fill="#F59E0B" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PairingStatusText" Text="Checking pairing status..." FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBox x:Name="PairCodeBox" PlaceholderText="6-Character Pairing Code" Width="260" />
                                    <Button x:Name="PairBtn" Content="Liên kết thiết bị" Click="PairButton_Click" Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="UnpairBtn" Content="Hủy liên kết" Click="UnpairButton_Click" />
                                    <Button x:Name="RefreshAllBtn" Content="Làm mới dữ liệu" Click="RefreshAllButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Spotify Now Playing Mini Player -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="#301DB954" BorderThickness="1" CornerRadius="10" Padding="16">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#201DB954" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="20" Foreground="#1DB954" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Name="MiniSpotifyTrackText" Text="Chưa phát nhạc" FontWeight="Bold" FontSize="15" Foreground="White" />
                                    <TextBlock x:Name="MiniSpotifyArtistText" Text="Spotify Desktop • Tạm dừng" FontSize="12" Foreground="#94A3B8" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="MiniSpotifyPrevBtn" Content="&#xE892;" FontFamily="Segoe MDL2 Assets" Click="SpotifyPrev_Click" />
                                    <Button x:Name="MiniSpotifyPlayBtn" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" Click="SpotifyPlayToggle_Click" Background="#1DB954" Foreground="Black" />
                                    <Button x:Name="MiniSpotifyNextBtn" Content="&#xE893;" FontFamily="Segoe MDL2 Assets" Click="SpotifyNext_Click" />
                                    <Button Content="Mở Spotify Studio" Click="OpenSpotifyStudio_Click" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 1. Thông số ESP32 Station -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE95F;" FontSize="16" Foreground="#00E5FF" />
                                    <TextBlock x:Name="EspStationSectionTitle" Text="Thông số ESP32 Station" FontWeight="Bold" FontSize="15" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" Background="#0A101D" BorderBrush="#2000E5FF" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Pin ESP32" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="EspBatteryValueText" Text="84%" FontSize="20" FontWeight="Bold" Foreground="#10B981" />
                                            <TextBlock x:Name="EspVoltageText" Text="3.99V" FontSize="11" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#0A101D" BorderBrush="#2000E5FF" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Sóng Wi-Fi" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="EspWifiValueText" Text="-60 dBm" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" />
                                            <TextBlock x:Name="EspWifiQualityText" Text="Mạnh" FontSize="11" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#0A101D" BorderBrush="#2000E5FF" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Màn hình OLED" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="EspViewValueText" Text="MAIN" FontSize="20" FontWeight="Bold" Foreground="#00E5FF" />
                                            <TextBlock Text="TFT 320×240 (ST7789)" FontSize="11" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. Thông số Server Companion -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE968;" FontSize="16" Foreground="#C084FC" />
                                    <TextBlock x:Name="ServerSectionTitle" Text="Thông số Server Companion" FontWeight="Bold" FontSize="15" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" Background="#120A1D" BorderBrush="#25A855F7" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="CPU Server" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="ServerCpuValueText" Text="6.5%" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" />
                                            <TextBlock Text="Backend process" FontSize="11" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#120A1D" BorderBrush="#25A855F7" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="RAM Server" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="ServerRamValueText" Text="41.3%" FontSize="20" FontWeight="Bold" Foreground="#C084FC" />
                                            <TextBlock Text="Active memory" FontSize="11" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#120A1D" BorderBrush="#25A855F7" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Dung lượng đĩa" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="ServerDiskValueText" Text="13.3 / 19.1GB" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" />
                                            <TextBlock Text="SSD storage" FontSize="11" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Thông số Máy tính (Windows PC) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="16" Foreground="#38BDF8" />
                                    <TextBlock x:Name="ComputerTitleText" Text="Thông số Máy tính (Windows PC)" FontWeight="Bold" FontSize="15" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" Background="#081426" BorderBrush="#2038BDF8" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="CPU Máy tính" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="ComputerCpuValueText" Text="14.5%" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#081426" BorderBrush="#2038BDF8" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="RAM Máy tính" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="ComputerRamValueText" Text="48.0%" FontSize="20" FontWeight="Bold" Foreground="#818CF8" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#081426" BorderBrush="#2038BDF8" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Pin máy" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="ComputerBatteryValueText" Text="92%" FontSize="20" FontWeight="Bold" Foreground="#10B981" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Background="#081426" BorderBrush="#2038BDF8" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Trạng thái" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="ComputerStatusText" Text="Online" FontSize="20" FontWeight="Bold" Foreground="#10B981" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 5. Dự báo thời tiết 48h (Weather Forecast Gallery) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE753;" FontSize="16" Foreground="#00E5FF" />
                                    <TextBlock x:Name="WeatherSectionTitle" Text="Dự báo thời tiết 48h (Weather Forecast)" FontWeight="Bold" FontSize="15" />
                                </StackPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,4,0,8">
                                    <StackPanel x:Name="WeatherGalleryStack" Orientation="Horizontal" Spacing="10">
                                        <!-- Dynamic weather cards will be added here via code-behind -->
                                    </StackPanel>
                                </ScrollViewer>
                                <TextBlock x:Name="WeatherEmptyText" Text="Đang tải dữ liệu thời tiết 48h từ máy chủ..." Foreground="#94A3B8" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <!-- 6. Tổng quan hệ sinh thái (Ecosystem Summary) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE81E;" FontSize="16" Foreground="#10B981" />
                                    <TextBlock x:Name="EcosystemSectionTitle" Text="Tổng quan hệ sinh thái" FontWeight="Bold" FontSize="15" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" Background="#061A14" BorderBrush="#2010B981" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Giấy nhớ đã lưu" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="EcosystemNotesText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#10B981" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#061A14" BorderBrush="#2010B981" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Đếm ngược đang chạy" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="EcosystemCountdownsText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#061A14" BorderBrush="#2010B981" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Khoảng dự báo thời tiết" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="EcosystemWeatherText" Text="16" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Background="#061A14" BorderBrush="#2010B981" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Chế độ tập trung" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="EcosystemFocusText" Text="Nghỉ" FontSize="18" FontWeight="Bold" Foreground="#C084FC" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <!-- ========================================================================= -->
                    <!-- SPOTIFY & ÂM NHẠC (SPOTIFY STUDIO)                                        -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="SpotifyPanel" Spacing="16" Visibility="Collapsed">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="SpotifyHeaderTitle" Text="Spotify &amp; Âm nhạc" FontSize="24" FontWeight="Bold" />
                            <Button Grid.Column="1" Content="Làm mới" Click="RefreshSpotify_Click" />
                        </Grid>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="#351DB954" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="20">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                                    <Border Grid.Column="0" Width="120" Height="120" CornerRadius="16" Background="#1A1DB954" BorderBrush="#501DB954" BorderThickness="1.5">
                                        <Grid>
                                            <Image x:Name="SpotifyCoverImage" Stretch="UniformToFill" Visibility="Collapsed" ImageOpened="SpotifyCoverImage_ImageOpened" ImageFailed="SpotifyCoverImage_ImageFailed" />
                                            <FontIcon x:Name="SpotifyCoverPlaceholder" Glyph="&#xE8D6;" FontSize="48" Foreground="#1DB954" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="#201DB954" CornerRadius="4" Padding="8,3">
                                                <TextBlock x:Name="SpotifyStatusBadge" Text="TẠM DỪNG" FontSize="11" FontWeight="Bold" Foreground="#1DB954" />
                                            </Border>
                                            <Border x:Name="SpotifyConnectBadge" Background="#1510B981" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="CONNECT ONLINE" FontSize="10" FontWeight="Bold" Foreground="#10B981" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="SpotifyTrackTitle" Text="Chưa phát nhạc" FontSize="20" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="SpotifyArtistName" Text="Spotify Desktop Client" FontSize="14" Foreground="#94A3B8" />
                                        <TextBlock x:Name="SpotifyAlbumName" Text="" FontSize="12" Foreground="#64748B" />
                                    </StackPanel>
                                </Grid>

                                <!-- Progress bar -->
                                <StackPanel Spacing="6">
                                    <ProgressBar x:Name="SpotifyProgressBar" Value="0" Maximum="100" Height="6" Foreground="#1DB954" />
                                    <Grid ColumnDefinitions="*,*">
                                        <TextBlock x:Name="SpotifyCurrentTimeText" Text="00:00" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas" />
                                        <TextBlock x:Name="SpotifyTotalTimeText" Grid.Column="1" HorizontalAlignment="Right" Text="00:00" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas" />
                                    </Grid>
                                </StackPanel>

                                <!-- Playback Controls & Volume -->
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                        <Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="44" Height="44" Click="SpotifyPrev_Click" />
                                        <Button x:Name="SpotifyPlayBtn" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="22" Width="52" Height="52" CornerRadius="26" Background="#1DB954" Foreground="Black" Click="SpotifyPlayToggle_Click" />
                                        <Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="44" Height="44" Click="SpotifyNext_Click" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE767;" FontSize="16" Foreground="#94A3B8" />
                                        <Slider x:Name="SpotifyVolumeSlider" Width="140" Minimum="0" Maximum="100" Value="50" />
                                        <TextBlock x:Name="SpotifyVolumeText" Text="50%" FontSize="12" Foreground="#94A3B8" Width="36" FontFamily="Consolas" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Synced Lyrics Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D2;" FontSize="16" Foreground="#A855F7" />
                                    <TextBlock Text="Lời bài hát thời gian thực (Synced Lyrics)" FontWeight="Bold" FontSize="15" />
                                </StackPanel>
                                <Border Background="#1538BDF8" CornerRadius="8" Padding="14,10">
                                    <TextBlock x:Name="SpotifyCurrentLyricText" Text="Đang đồng bộ lời bài hát từ Spotify / LRCLIB..." FontSize="16" FontWeight="Bold" Foreground="#38BDF8" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock x:Name="SpotifyNextLyricText" Text="..." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="14,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================================= -->
                    <!-- PHẦN CỨNG & TRẠM ESP32 (HARDWARE & ESP32 STATION)                         -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="StationPanel" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="Phần cứng &amp; Trạm ESP32" FontSize="24" FontWeight="Bold" />

                        <!-- Live OLED Monitor Preview -->
                        <Border Background="#060911" BorderBrush="#00E5FF" BorderThickness="2" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                                        <Ellipse Fill="#10B981" Width="8" Height="8" VerticalAlignment="Center" />
                                        <TextBlock Text="320×240 TFT (ST7789) MONITOR" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="OledModeBadge" Text="CLOCK FACE" Foreground="#00E5FF" FontFamily="Consolas" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>

                                <Border Background="#030509" BorderBrush="#2000E5FF" BorderThickness="1" CornerRadius="6" Padding="12" Height="180" MaxWidth="240" HorizontalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock x:Name="OledScreenTitle" Text="DESKFLOW CLOCK" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="OledScreenMain" Text="12:30 :45" Foreground="#00E5FF" FontFamily="Consolas" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="OledScreenSub" Text="SUN 08 NOV • 28°C HCM" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="Bấm vào bất kỳ mặt đồng hồ hoặc màn hình bên dưới để xem trước. Bấm Áp dụng để gửi sang ESP32." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                    <Button Content="Áp dụng lên trạm OLED" Click="ApplyOledPreview_Click" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="Đang hiển thị trên trạm:" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock x:Name="OledMonitorLiveViewText" Text="MAIN" Foreground="#22C55E" FontFamily="Consolas" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Clock Face Studio (7 Styles) -->
                        <TextBlock Text="Clock Face Studio (7 kiểu mặt đồng hồ)" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="180" ItemHeight="95">
                            <Button Click="SelectClockStyle_Click" Tag="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,8,8">
                                <StackPanel Spacing="3">
                                    <Border Background="#0A0E17" CornerRadius="4" Padding="4">
                                        <TextBlock Text="12:30 :45" Foreground="#00E5FF" FontFamily="Consolas" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="1. Digital Classic" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Text="Bold digits with seconds" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button Click="SelectClockStyle_Click" Tag="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,8,8">
                                <StackPanel Spacing="3">
                                    <Border Background="#0A0E17" CornerRadius="4" Padding="4">
                                        <TextBlock Text="12:30:45" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="2. Minimalist" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Text="Clean typography" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button Click="SelectClockStyle_Click" Tag="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,8,8">
                                <StackPanel Spacing="3">
                                    <Border Background="#0A0E17" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="4">
                                        <TextBlock Text="[ 12:30 ]" Foreground="#00E5FF" FontFamily="Consolas" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="3. Neon Cyber" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Text="Cyber glow frame" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button Click="SelectClockStyle_Click" Tag="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,8,8">
                                <StackPanel Spacing="3">
                                    <Border Background="#0A0E17" CornerRadius="4" Padding="4">
                                        <TextBlock Text="(● 12:30:45)" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="4. Analog Dial" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Text="Round 3-hand dial" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button Click="SelectClockStyle_Click" Tag="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,8,8">
                                <StackPanel Spacing="3">
                                    <Border Background="#0A0E17" CornerRadius="4" Padding="4">
                                        <TextBlock Text="[ 12 ] : [ 30 ]" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="5. Flip Clock" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Text="Retro split-cards" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button Click="SelectClockStyle_Click" Tag="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,8,8">
                                <StackPanel Spacing="3">
                                    <Border Background="#0A0E17" CornerRadius="4" Padding="4">
                                        <TextBlock Text=":: :: :: ::" Foreground="#00E5FF" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="6. Binary Matrix" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Text="BCD 4×4 LED matrix" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button Click="SelectClockStyle_Click" Tag="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,8,8">
                                <StackPanel Spacing="3">
                                    <Border Background="#0A0E17" CornerRadius="4" Padding="4">
                                        <TextBlock Text="TWELVE 30" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="7. Word Clock" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Text="Spelled out text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" />
                                </StackPanel>
                            </Button>
                        </VariableSizedWrapGrid>

                        <!-- Clock Accent Color -->
                        <TextBlock Text="Màu điểm nhấn đồng hồ (Clock Accent Color)" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Sky Blue" Tag="#38BDF8" Click="ClockAccentColor_Click" Background="#38BDF8" Foreground="Black" FontWeight="SemiBold" />
                            <Button Content="Emerald" Tag="#10B981" Click="ClockAccentColor_Click" Background="#10B981" Foreground="Black" FontWeight="SemiBold" />
                            <Button Content="Amber" Tag="#F59E0B" Click="ClockAccentColor_Click" Background="#F59E0B" Foreground="Black" FontWeight="SemiBold" />
                            <Button Content="Rose" Tag="#EF4444" Click="ClockAccentColor_Click" Background="#EF4444" Foreground="White" FontWeight="SemiBold" />
                            <Button Content="Purple" Tag="#8B5CF6" Click="ClockAccentColor_Click" Background="#8B5CF6" Foreground="White" FontWeight="SemiBold" />
                            <Button Content="Pink" Tag="#EC4899" Click="ClockAccentColor_Click" Background="#EC4899" Foreground="White" FontWeight="SemiBold" />
                            <Button Content="White" Tag="#FFFFFF" Click="ClockAccentColor_Click" Background="#FFFFFF" Foreground="Black" FontWeight="SemiBold" />
                        </StackPanel>

                        <!-- OLED Display Views -->
                        <TextBlock Text="Chuyển màn hình OLED" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Chính (Default)" Tag="main" Click="SwitchViewButton_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Đồng hồ" Tag="clock" Click="SwitchViewButton_Click" />
                            <Button Content="Thời khóa biểu" Tag="tkb" Click="SwitchViewButton_Click" />
                            <Button Content="Lịch Google" Tag="calendar" Click="SwitchViewButton_Click" />
                            <Button Content="Thời tiết" Tag="weather" Click="SwitchViewButton_Click" />
                            <Button Content="Lời bài hát" Tag="lyrics" Click="SwitchViewButton_Click" />
                            <Button Content="Ghi chú" Tag="notes" Click="SwitchViewButton_Click" />
                            <Button Content="Đếm ngược" Tag="countdown" Click="SwitchViewButton_Click" />
                            <Button Content="Tập trung" Tag="focus" Click="SwitchViewButton_Click" />
                            <Button Content="Thông số máy chủ" Tag="stats" Click="SwitchViewButton_Click" />
                        </StackPanel>

                        <!-- NeoPixel LED & RGB Lamp -->
                        <TextBlock Text="Đèn bàn WS2812B NeoPixel RGB" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="LampHexBox" Header="Mã màu Hex" Text="#8B5CF6" Width="140" TextChanged="LampHexBox_TextChanged" />
                            <Border x:Name="LampColorSwatch" Width="32" Height="32" CornerRadius="16" Background="#8B5CF6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Bottom" Margin="4,0" />
                            <DropDownButton Content="Bảng màu (Palette)" VerticalAlignment="Bottom">
                                <DropDownButton.Flyout>
                                    <Flyout>
                                        <ColorPicker x:Name="LampColorPicker" ColorChanged="LampColorPicker_ColorChanged" IsColorSpectrumVisible="True" IsHexInputVisible="True" />
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button Content="Đặt màu tùy biến" Click="SetLampColorButton_Click" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>

                        <!-- 7 màu có sẵn trên ESP32, xếp 4 ô mỗi hàng -->
                        <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" Margin="0,6,0,0">
                            <Button Grid.Row="0" Grid.Column="0" Content="Trắng" Tag="#FFFFFF" Click="PresetLampColor_Click" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="0" Grid.Column="1" Content="Đỏ" Tag="#FF0000" Click="PresetLampColor_Click" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Xanh lá" Tag="#00FF00" Click="PresetLampColor_Click" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="0" Grid.Column="3" Content="Xanh dương" Tag="#0000FF" Click="PresetLampColor_Click" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="1" Grid.Column="0" Content="Vàng" Tag="#FFFF00" Click="PresetLampColor_Click" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="1" Grid.Column="1" Content="Tím" Tag="#FF00FF" Click="PresetLampColor_Click" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Xanh ngọc" Tag="#00FFFF" Click="PresetLampColor_Click" HorizontalAlignment="Stretch" />
                        </Grid>

                        <!-- Đèn: Bật / Tắt + độ sáng LED 0-100% (đèn nền OLED là cố định) -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                            <Button x:Name="LampOnButton" Content="💡 Bật đèn" Click="TurnLampOnButton_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="LampOffButton" Content="🌙 Tắt đèn" Click="TurnLampOffButton_Click" />
                            <Slider x:Name="LedBrightnessSlider"
                                    Header="Độ sáng LED (%)"
                                    Width="220"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="100"
                                    StepFrequency="5"
                                    TickFrequency="10"
                                    TickPlacement="Outside"
                                    ValueChanged="LedBrightnessSlider_ValueChanged" />
                            <TextBlock x:Name="LedBrightnessText"
                                       Text="100%"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       VerticalAlignment="Bottom"
                                       Width="44" />
                        </StackPanel>

                        <!-- Hardware Buzzer Testing -->
                        <TextBlock Text="Thử nghiệm còi chip ESP32" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="40ms" Tag="40" Click="PresetBuzz_Click" />
                            <Button Content="80ms" Tag="80" Click="PresetBuzz_Click" />
                            <Button Content="150ms" Tag="150" Click="PresetBuzz_Click" />
                            <Button Content="250ms" Tag="250" Click="PresetBuzz_Click" />
                            <Button Content="500ms" Tag="500" Click="PresetBuzz_Click" />
                            <Button Content="Dập còi khẩn cấp" Click="EmergencyStop_Click" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>


                    <!-- ========================================================================= -->
                    <!-- 2. BÁO THỨC & CÒI BÁO (ALARMS & BUZZER)                                   -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="AlarmsPanel" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="Báo thức &amp; Còi báo" FontSize="24" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="AlarmTimeBox" Header="Giờ (HH:MM)" Text="07:00" Width="120" />
                            <TextBox x:Name="AlarmLabelBox" Header="Nhãn báo thức" Text="Thức dậy buổi sáng" Width="200" />
                            <TextBox x:Name="AlarmDurationBox" Header="Thời lượng còi (ms)" Text="250" Width="130" />
                            <Button Content="Lưu báo thức" Click="SaveAlarmButton_Click" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Làm mới danh sách" Click="RefreshAlarmsButton_Click" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <ListView x:Name="AlarmsListView" MaxHeight="280" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4" ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Time}" FontWeight="SemiBold" FontSize="16" />
                                            <TextBlock Text="{Binding Label}" Opacity="0.8" />
                                            <TextBlock Text="{Binding RepeatSummary}" FontSize="12" Opacity="0.6" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding Enabled}" Toggled="AlarmToggle_Toggled" Tag="{Binding Id}" Margin="8,0" />
                                        <Button Grid.Column="2" Content="Xóa" Click="DeleteAlarmButton_Click" Tag="{Binding Id}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>


                    <!-- ========================================================================= -->
                    <!-- 2b. THỜI KHÓA BIỂU (TKB / TIMETABLE)                                      -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="TkbPanel" Spacing="16" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Thời khóa biểu (TKB) &amp; Lịch học" FontSize="20" FontWeight="Bold" />
                                    <TextBlock Text="Đồng bộ lịch học các tiết sáng chiều và đồng phục lên vi điều khiển ESP32." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Background="#20F59E0B" CornerRadius="8" Padding="10,4">
                                        <TextBlock x:Name="TkbWeekText" Text="Tuần --" Foreground="#F59E0B" FontWeight="Bold" FontSize="12" />
                                    </Border>
                                    <Button Content="Hiển thị TKB lên ESP32" Style="{StaticResource AccentButtonStyle}" Click="TkbSyncEsp32_Click" />
                                    <Button Content="Làm mới" Click="TkbRefresh_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <!-- Hôm nay -->
                            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="TkbTodayTitle" Text="Lịch học Hôm nay" FontSize="16" FontWeight="SemiBold" Foreground="#38BDF8" />
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="BUỔI SÁNG" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="TkbTodayMorningUniform" Text="Đồng phục: --" FontSize="12" Foreground="#F59E0B" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TkbTodayMorningClasses" Text="Đang tải..." FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="BUỔI CHIỀU" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="TkbTodayAfternoonUniform" Text="Đồng phục: --" FontSize="12" Foreground="#10B981" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TkbTodayAfternoonClasses" Text="Đang tải..." FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Ngày mai -->
                            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="TkbTomorrowTitle" Text="Lịch học Ngày mai" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA" />
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="BUỔI SÁNG" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="TkbTomorrowMorningUniform" Text="Đồng phục: --" FontSize="12" Foreground="#F59E0B" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TkbTomorrowMorningClasses" Text="Đang tải..." FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="BUỔI CHIỀU" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock x:Name="TkbTomorrowAfternoonUniform" Text="Đồng phục: --" FontSize="12" Foreground="#10B981" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TkbTomorrowAfternoonClasses" Text="Đang tải..." FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ========================================================================= -->
                    <!-- LỊCH GOOGLE (GOOGLE CALENDAR - OAUTH 2.0 + PRIVATE ICAL)                  -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="CalendarPanel" Spacing="16" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Lịch Google (Google Calendar)" FontSize="22" FontWeight="Bold" />
                                    <TextBlock x:Name="CalStatusText" Text="Chưa kết nối Google Calendar" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Hiện lên ESP32" Style="{StaticResource AccentButtonStyle}" Click="CalSyncEsp32_Click" />
                                    <Button Content="Đồng bộ ngay" Click="CalRefresh_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- OAuth + Private iCal Configuration -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Google OAuth 2.0 -->
                            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Google OAuth 2.0 (2 chiều)" FontSize="16" FontWeight="SemiBold" Foreground="#38BDF8" />
                                    <TextBlock x:Name="CalOAuthAccountText" Text="Chưa đăng nhập Google OAuth" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <ComboBox x:Name="CalPickerCombo" Header="Lịch đang chọn" HorizontalAlignment="Stretch" Visibility="Collapsed" SelectionChanged="CalPickerCombo_SelectionChanged" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Đăng nhập Google" Style="{StaticResource AccentButtonStyle}" Click="CalOAuthConnect_Click" />
                                        <Button x:Name="CalOAuthDisconnectBtn" Content="Ngắt OAuth" Visibility="Collapsed" Click="CalOAuthDisconnect_Click" />
                                    </StackPanel>
                                    <Expander Header="Cấu hình OAuth Client ID / Secret" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <TextBox x:Name="CalClientIdBox" Header="Google Client ID" PlaceholderText="xxx.apps.googleusercontent.com" />
                                            <PasswordBox x:Name="CalClientSecretBox" Header="Google Client Secret (trống = giữ nguyên)" />
                                            <TextBox x:Name="CalRedirectUriBox" Header="Redirect URI" Text="https://10th012013.duckdns.org/api/app/calendar/oauth/callback" />
                                            <Button Content="Lưu thông tin OAuth" Click="CalSaveOAuthCreds_Click" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- Private iCal (.ics) Quick Link -->
                            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Kết nối nhanh Private iCal (.ics)" FontSize="16" FontWeight="SemiBold" Foreground="#10B981" />
                                    <TextBlock Text="Dán 'Secret address in iCal format' trong Google Calendar Settings (chỉ xem, không cần Google Cloud)." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBox x:Name="CalIcalUrlBox" Header="Secret iCal (.ics) URL" PlaceholderText="https://calendar.google.com/calendar/ical/.../basic.ics" />
                                    <Button Content="Lưu &amp; Đồng bộ iCal" Style="{StaticResource AccentButtonStyle}" Click="CalSaveIcal_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Create Event Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Thêm sự kiện lên Google Calendar (cần Google OAuth)" FontSize="15" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="CalNewTitleBox" Header="Tên sự kiện" Width="220" PlaceholderText="VD: Họp nhóm" />
                                    <TextBox x:Name="CalNewDateBox" Header="Ngày (YYYY-MM-DD)" Width="140" PlaceholderText="2026-11-21" />
                                    <TextBox x:Name="CalNewStartBox" Header="Bắt đầu" Width="90" Text="09:00" />
                                    <TextBox x:Name="CalNewEndBox" Header="Kết thúc" Width="90" Text="10:00" />
                                    <TextBox x:Name="CalNewLocBox" Header="Địa điểm" Width="150" PlaceholderText="Online / Phòng..." />
                                    <ToggleSwitch x:Name="CalNewAllDaySwitch" Header="Cả ngày" OffContent="Giờ" OnContent="Cả ngày" VerticalAlignment="Bottom" />
                                    <Button Content="Thêm" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Click="CalCreateEvent_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Month Grid Calendar -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="◀" Click="CalPrevMonth_Click" />
                                    <TextBlock x:Name="CalMonthTitleText" Grid.Column="1" Text="Tháng --/----" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                        <Button Content="Hôm nay" Click="CalTodayMonth_Click" />
                                        <Button Content="▶" Click="CalNextMonth_Click" />
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="CalMonthGrid" ColumnSpacing="4" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                                <TextBlock x:Name="CalSelectedDayHeaderText" Text="Ngày đã chọn" FontSize="14" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,4,0,0" />
                                <StackPanel x:Name="CalSelectedDayEventsPanel" Spacing="4" />
                            </StackPanel>
                        </Border>

                        <!-- Events List -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Sự kiện sắp tới (30 ngày)" FontSize="16" FontWeight="SemiBold" />
                                <StackPanel x:Name="CalEventsListPanel" Spacing="8" />
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <!-- ========================================================================= -->
                    <!-- 3. CÔNG CỤ & GROQ AI (TOOLS & GROQ AI)                                    -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="ToolsPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Công cụ &amp; Groq AI" FontSize="24" FontWeight="Bold" />

                        <!-- Group 1: Ghi chú dán tường (Sticky Notes) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Ghi chú dán tường (Sticky Notes)" FontWeight="Bold" FontSize="15" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="NewNoteTextBox" PlaceholderText="Viết ghi chú ngắn để ghim lên màn hình OLED ESP32..." Width="360" />
                                    <Button Content="Thêm ghi chú" Click="AddNoteButton_Click" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                                <ListView x:Name="NotesListView" MaxHeight="220" SelectionMode="None" />
                            </StackPanel>
                        </Border>

                        <!-- Group 2: Đếm ngược ngày thi & Sự kiện (Countdowns) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Đếm ngược ngày thi &amp; Sự kiện (Countdowns)" FontWeight="Bold" FontSize="15" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="NewCountdownNameBox" PlaceholderText="Tên sự kiện (VD: Thi HK1, Tốt nghiệp)" Width="260" />
                                    <TextBox x:Name="NewCountdownDateBox" PlaceholderText="YYYY-MM-DD hoặc DD/MM" Width="180" />
                                    <Button Content="Thêm đếm ngược" Click="AddCountdownButton_Click" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                                <ListView x:Name="CountdownsListView" MaxHeight="220" SelectionMode="None" />
                            </StackPanel>
                        </Border>

                        <!-- Group 3b: Danh ngôn Groq AI (AI Quote Generator) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE735;" FontSize="16" Foreground="#EC4899" />
                                    <TextBlock x:Name="QuoteSectionTitle" Text="Danh ngôn tạo động lực (Groq AI Quotes)" FontWeight="Bold" FontSize="15" />
                                </StackPanel>
                                <Border Background="#160E2A" BorderBrush="#30EC4899" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="AiQuoteText" Text="“Kiên trì hôm nay, thành công ngày mai!”" FontStyle="Italic" FontSize="15" FontWeight="SemiBold" Foreground="#E0E7FF" TextWrapping="Wrap" />
                                        <TextBlock x:Name="AiQuoteAuthor" Text="— Groq AI" FontSize="12" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBox x:Name="QuoteTopicBox" Text="học tập và kiên trì" PlaceholderText="Chủ đề (ví dụ: học tập, sáng tạo)" Width="280" />
                                    <Button x:Name="GenerateQuoteBtn" Content="Sinh câu danh ngôn AI" Click="GenerateQuote_Click" Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="PinQuoteBtn" Content="Ghim lên ESP32" Click="PinQuote_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Group 3: Live Bidirectional Morse Code Studio -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Phòng thu mã Morse song chiều (Live Morse Studio)" FontWeight="Bold" FontSize="15" />
                                <TextBlock Text="Chuyển đổi trực tiếp thời gian thực: gõ chữ tự động dịch sang Morse, gõ/bấm Morse tự động dịch sang chữ." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />

                                <TextBlock Text="Văn bản thường (Plain Text - Live Sync)" FontWeight="SemiBold" FontSize="13" />
                                <TextBox x:Name="MorsePlainTextBox" Text="SOS DESKFLOW" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" TextChanged="MorsePlainTextBox_TextChanged" />

                                <TextBlock Text="Mã Morse (Morse Code - Live Sync)" FontWeight="SemiBold" FontSize="13" Margin="0,6,0,0" />
                                <TextBox x:Name="MorsePatternTextBox" Text="... --- ... / -.. . ... -.- ..-. .-.. --- .--" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" TextChanged="MorsePatternTextBox_TextChanged" />

                                <!-- Quick Morse Keypad -->
                                <TextBlock Text="Bàn phím gõ nhanh Morse:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="• (Dot)" Click="MorseDot_Click" MinWidth="80" />
                                    <Button Content="— (Dash)" Click="MorseDash_Click" MinWidth="80" />
                                    <Button Content="␣ [Ký tự]" Click="MorseSpace_Click" MinWidth="85" />
                                    <Button Content="/ [Từ]" Click="MorseSlash_Click" MinWidth="80" />
                                    <Button Content="⌫ Xóa ký tự" Click="MorseBackspace_Click" MinWidth="95" />
                                    <Button Content="✕ Xóa hết" Click="MorseClear_Click" MinWidth="85" />
                                </StackPanel>

                                <!-- Hardware Buzzer Controls -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                    <Button Content="▶ Phát còi ESP32" Click="PlayMorse_Click" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="⏹ Dừng phát" Click="StopMorse_Click" />
                                    <Button Content="Sao chép Morse" Click="CopyMorse_Click" />
                                    <Button Content="Sao chép chữ" Click="CopyText_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Group: Trình phát nhạc MIDI qua còi ESP32 (Buzzer MIDI Jukebox) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Trình phát nhạc MIDI qua còi ESP32 (Buzzer MIDI Jukebox)" FontWeight="Bold" FontSize="15" />
                                <TextBlock Text="Chọn bài mẫu 8-bit hoặc chọn file .mid từ máy tính để phát qua loa còi ESP32:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="MelodyPresetCombo" Header="Giai điệu 8-bit có sẵn" Width="280">
                                        <ComboBoxItem Content="Super Mario Bros Theme (Koji Kondo)" Tag="mario" IsSelected="True" />
                                        <ComboBoxItem Content="Never Gonna Give You Up (Rick Astley)" Tag="rickroll" />
                                        <ComboBoxItem Content="Tetris Theme - Korobeiniki" Tag="tetris" />
                                        <ComboBoxItem Content="Astronomia - Coffin Dance" Tag="coffin" />
                                        <ComboBoxItem Content="Star Wars - Imperial March" Tag="starwars" />
                                        <ComboBoxItem Content="Nokia Tune - Gran Vals" Tag="nokia" />
                                    </ComboBox>
                                    <Button Content="▶ Phát bài mẫu" Click="PlayMelodyPreset_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
                                    <Button Content="📁 Chọn file .midi từ máy..." Click="SelectMidiFile_Click" VerticalAlignment="Bottom" />
                                    <Button Content="⏹ Dừng phát" Click="StopMelody_Click" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Group 4: Chế độ tập trung (Focus Mode) -->
                        <Border x:Name="FocusModeCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Chế độ tập trung &amp; Pomodoro (Focus Mode)" FontWeight="Bold" FontSize="15" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Bắt đầu 25 phút" Click="StartFocus25_Click" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="Bắt đầu 50 phút" Click="StartFocus50_Click" />
                                    <Button Content="Dừng phiên tập trung" Click="StopFocus_Click" />
                                </StackPanel>

                                <!-- Thời lượng tuỳ chỉnh: 1–300 phút (ví dụ 2 phút) -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox x:Name="FocusDurationBox"
                                               Header="Số phút (1–300)"
                                               Value="25"
                                               Minimum="1"
                                               Maximum="300"
                                               SmallChange="1"
                                               LargeChange="5"
                                               SpinButtonPlacementMode="Compact"
                                               Width="180"
                                               VerticalAlignment="Bottom" />
                                    <Button Content="Bắt đầu với số phút này"
                                            Click="StartFocusCustom_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            VerticalAlignment="Bottom" />
                                </StackPanel>

                                <TextBlock x:Name="FocusLockHintText"
                                           Text="Focus Mode đang bật: cửa sổ luôn nổi và không thể đóng. Giải bài toán để mở khoá."
                                           Foreground="#C084FC"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />

                                <StackPanel x:Name="FocusChallengePanel" Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="Giải bài toán để mở khoá sớm:" FontWeight="SemiBold" />
                                    <TextBlock x:Name="FocusChallengeQuestionText"
                                               Text=""
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#38BDF8"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox x:Name="FocusChallengeAnswerBox"
                                                 Width="140"
                                                 PlaceholderText="Đáp án (số nguyên)"
                                                 KeyDown="FocusChallengeAnswerBox_KeyDown" />
                                        <Button Content="Kiểm tra &amp; Mở khoá"
                                                Click="VerifyFocusChallenge_Click"
                                                Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <!-- ========================================================================= -->
                    <!-- 4. CÀI ĐẶT & GIAO DIỆN (SETTINGS & APPEARANCE)                            -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="SettingsPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Cài đặt &amp; Giao diện ứng dụng" FontSize="24" FontWeight="Bold" />

                        <!-- Ngôn ngữ & Chế độ tối ESP32 độc lập -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Ngôn ngữ &amp; Chế độ tối ESP32 độc lập" FontWeight="Bold" FontSize="15" />

                                <ComboBox x:Name="LanguageCombo" Header="Ngôn ngữ ứng dụng (Display Language)" SelectionChanged="LanguageCombo_SelectionChanged" Width="280">
                                    <ComboBoxItem Content="Tiếng Việt (Vietnamese)" Tag="vi" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                </ComboBox>

                                <ComboBox x:Name="Esp32LanguageCombo" Header="Ngôn ngữ màn hình ESP32 (Device Language)" SelectionChanged="Esp32LanguageCombo_SelectionChanged" Width="280">
                                    <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                </ComboBox>

                                <TextBlock Text="Chế độ tối màn hình ESP32 độc lập (Không phụ thuộc theme máy tính):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="Esp32ThemeCombo" Header="Chế độ ESP32" Width="260">
                                        <ComboBoxItem Content="Đồng bộ theo giờ (Sync)" Tag="scheduled" />
                                        <ComboBoxItem Content="Luôn Sáng (Light Mode)" Tag="off" />
                                        <ComboBoxItem Content="Luôn Tối (Dark Mode)" Tag="always_on" />
                                    </ComboBox>
                                    <Button Content="Áp dụng lên màn hình ESP32" Click="ApplyEsp32Theme_Click" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Giao diện Windows & Lịch Dark Mode -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Giao diện ứng dụng Windows &amp; Chế độ tối theo lịch" FontWeight="Bold" FontSize="15" />
                                <ComboBox x:Name="ThemeModeCombo" Header="Chế độ giao diện Windows" SelectionChanged="ThemeModeCombo_SelectionChanged" Width="280">
                                    <ComboBoxItem Content="Mặc định hệ thống (System Default)" Tag="system" />
                                    <ComboBoxItem Content="Sáng (Light Mode)" Tag="light" />
                                    <ComboBoxItem Content="Tối (Dark Mode)" Tag="dark" />
                                    <ComboBoxItem Content="Theo lịch hẹn giờ (Scheduled)" Tag="scheduled" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="DarkStartTextBox" Header="Bắt đầu (HH:MM)" Text="20:00" Width="140" />
                                    <TextBox x:Name="DarkEndTextBox" Header="Kết thúc (HH:MM)" Text="06:00" Width="140" />
                                    <Button Content="Lưu lịch hẹn giờ" Click="SaveScheduleButton_Click" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Thiết bị kết nối & Chọn máy hiển thị thông số trên ESP32 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Thiết bị kết nối &amp; Chọn máy hiển thị thông số trên ESP32" FontWeight="Bold" FontSize="15" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="DisplayDeviceCombo" Header="Máy đang chọn để hiển thị CPU/RAM lên ESP32" SelectionChanged="DisplayDeviceCombo_SelectionChanged" Width="320" />
                                    <Button Content="Làm mới danh sách thiết bị" Click="RefreshDevicesButton_Click" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <ListView x:Name="DevicesListView" MaxHeight="220" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4" ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Text="{Binding Platform}" Opacity="0.7" FontSize="12" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Đổi tên" Click="RenameDeviceButton_Click" Tag="{Binding DeviceId}" Margin="8,0" />
                                                <Button Grid.Column="2" Content="Hủy liên kết" Click="UnlinkDeviceButton_Click" Tag="{Binding DeviceId}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Kết nối máy chủ API & Kiểm tra tình trạng -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Kết nối máy chủ &amp; Kiểm tra tình trạng (/api/app/health)" FontWeight="Bold" FontSize="15" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="ApiUrlTextBox" Header="URL máy chủ Backend" Width="380" />
                                    <Button Content="Kiểm tra kết nối" Click="TestHealthButton_Click" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>

    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Chào mừng đến với Deskflow</string>
    <string name="onboarding_welcome_desc">Deskflow kết nối điện thoại Android của bạn vào hệ sinh thái Deskflow (Discord bot, tiện ích trình duyệt, thiết bị IoT) để quản lý Chế độ tập trung, Báo thức toán học, Thời khóa biểu và phát nhạc Spotify.</string>
    <string name="onboarding_how_it_works_title">Cơ chế hoạt động</string>
    <string name="onboarding_how_it_works_desc">Khi bật Focus Mode, các trang web giải trí và mạng xã hội sẽ bị chặn. Để tắt sớm, bạn bắt buộc phải giải bài toán số học do DeskFlow AI tạo ra để kiểm tra độ tỉnh táo.</string>
    <string name="onboarding_lock_title">Khóa phiên tập trung</string>
    <string name="onboarding_lock_desc">Khi bật Focus Mode, để kết thúc phiên bạn phải giải đúng thử thách toán học từ máy chủ DeskFlow. Mọi tính năng điện thoại và Internet thông thường vẫn hoạt động bình thường.</string>
    <string name="onboarding_privacy_title">Bảo mật tuyệt đối</string>
    <string name="onboarding_privacy_desc">DeskFlow không can thiệp lưu lượng mạng và không yêu cầu quyền VPN. Toàn bộ tính năng nghe gọi, lướt web và ứng dụng của bạn hoạt động hoàn toàn bình thường.</string>

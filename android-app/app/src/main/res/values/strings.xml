    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to Deskflow</string>
    <string name="onboarding_welcome_desc">Deskflow connects your Android phone with your Deskflow ecosystem (Discord, browser extensions, IoT devices) to manage Focus Mode, Math Alarms, school timetables, and Spotify playback.</string>
    <string name="onboarding_how_it_works_title">How Restrictions Work</string>
    <string name="onboarding_how_it_works_desc">During an active Focus session, social media and entertainment websites are filtered locally. To prevent bypasses, exiting early requires solving an arithmetic challenge generated by DeskFlow AI.</string>
    <string name="onboarding_lock_title">Focus Lock Mode</string>
    <string name="onboarding_lock_desc">When Focus Mode is active, deactivation requires solving a math challenge verified by the DeskFlow backend. All ordinary phone functions and apps continue working normally.</string>
    <string name="onboarding_privacy_title">Privacy First</string>
    <string name="onboarding_privacy_desc">DeskFlow does not inspect your web traffic or require VPN permissions. All phone functionality, browsing, and apps continue working without interruption.</string>

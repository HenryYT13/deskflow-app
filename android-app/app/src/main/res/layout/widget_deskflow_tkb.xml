<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tkb_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tkb_widget_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TKB HÔM NAY"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tkb_widget_dismissal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tan: --"
            android:textColor="#FF10B981"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tkb_widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Sync"
            android:textColor="#FFA1A1AA"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tkb_widget_uniform"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Đồng phục: --"
        android:textColor="#FFA1A1AA"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tkb_widget_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:text="Nhấn Sync để tải Thời khóa biểu chi tiết theo tiết"
        android:textColor="#FFD4D4D8"
        android:textSize="11sp" />
</LinearLayout>
